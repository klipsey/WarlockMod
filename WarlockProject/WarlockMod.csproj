<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Configurations>Release;Debug</Configurations>
    <TestProfilePath Condition="'$(TestProfilePath)' == ''">F:\WebfishingMods\RiskOfRain2\profiles\testing</TestProfilePath>
    <DeployToTestProfile Condition="'$(DeployToTestProfile)' == ''">true</DeployToTestProfile>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".gitignore" />
    <None Remove="nuget.config" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Core" Version="5.4.*" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
		<PackageReference Include="RoR2BepInExPack" Version="1.41.0" />
		<PackageReference Include="MMHOOK.RoR2" Version="2025.12.9">
			<NoWarn>NU1701</NoWarn>
		</PackageReference>
		<PackageReference Include="R2API.Core" Version="5.*" />
		<PackageReference Include="R2API.Prefab" Version="1.*" />
		<PackageReference Include="R2API.Language" Version="1.*" />
		<PackageReference Include="R2API.DamageType" Version="1.*" />
		<PackageReference Include="R2API.Dot" Version="1.*" />
		<PackageReference Include="R2API.Networking" Version="1.*" />
		<PackageReference Include="R2API.Sound" Version="1.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="ShaderSwapper">
			<HintPath>libs\ShaderSwapper.dll</HintPath>
		</Reference>
		<Reference Include="Unity.Postprocessing.Runtime">
			<HintPath>libs\Unity.Postprocessing.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="CustomEmotesAPI">
			<HintPath>libs\CustomEmotesAPI.dll</HintPath>
			<HintPath Condition="Exists('$(TestProfilePath)\BepInEx\plugins\MetrosexualFruitcake-CustomEmotesAPI\CustomEmotesAPI.dll')">$(TestProfilePath)\BepInEx\plugins\MetrosexualFruitcake-CustomEmotesAPI\CustomEmotesAPI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="RiskOfOptions">
			<HintPath>libs\RiskOfOptions.dll</HintPath>
			<Private>false</Private>
		</Reference>
			<Reference Include="AncientScepter">
			<HintPath>libs\AncientScepter.dll</HintPath>
		</Reference>
	</ItemGroup>
  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(SkipPackaging)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BundlePath>$(ProjectDir)..\WarlockUnityProject\AssetBundles\StandaloneWindows\warlock</BundlePath>
      <PluginOutput>$(ProjectDir)..\Build\plugins</PluginOutput>
    </PropertyGroup>
    <Error Condition="!Exists('$(BundlePath)')" Text="Build the Warlock asset bundle using Tools/Warlock/Setup and Build before packaging." />
    <Message Importance="high" Text="Packaging Warlock asset bundle: $(BundlePath)" />
    <MakeDir Directories="$(PluginOutput)\AssetBundles;$(PluginOutput)\Soundbanks" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutput)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(BundlePath)" DestinationFolder="$(PluginOutput)\AssetBundles" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)interrogator_bank.bnk" DestinationFolder="$(PluginOutput)\Soundbanks" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="DeployMod" AfterTargets="PackageMod" Condition="'$(DeployToTestProfile)' == 'true' and '$(SkipPackaging)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TestProfilePath)\BepInEx\plugins')" Text="Test profile does not exist: $(TestProfilePath)" />
    <Copy SourceFiles="$(PluginOutput)\WarlockMod.dll" DestinationFolder="$(TestProfilePath)\BepInEx\plugins\kenko-Warlock" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PluginOutput)\AssetBundles\warlock" DestinationFolder="$(TestProfilePath)\BepInEx\plugins\kenko-Warlock\AssetBundles" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PluginOutput)\Soundbanks\interrogator_bank.bnk" DestinationFolder="$(TestProfilePath)\BepInEx\plugins\kenko-Warlock\Soundbanks" SkipUnchangedFiles="true" />
  </Target>

</Project>